# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Supabase Configuration (placeholder for development)
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder

# ============================================================================
# WEB CRAWLER APIs (Phase 1)
# ============================================================================
# Recipe Data APIs
# Spoonacular - Visit https://spoonacular.com/food-api to get free API key
SPOONACULAR_API_KEY=

# Edamam Recipe Search - Visit https://www.edamam.com/food-api for credentials
EDAMAM_API_ID=
EDAMAM_API_KEY=

# Web Scraping Proxy (Optional, for sites blocking automated access)
# Options: Bright Data, Oxylabs, ScraperAPI, or custom proxy service
SCRAPE_PROXY_URL=
BRIGHTDATA_PROXY=

# Web Crawler Configuration
WEB_CRAWLER_TIMEOUT=30000
WEB_CRAWLER_RATE_LIMIT=3
WEB_CRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
WEB_CRAWLER_MAX_PAGES=5000
