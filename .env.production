# Production Environment Configuration

# ============================================================================
# SUPABASE - Database & Authentication
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# ============================================================================
# ERROR MONITORING - Sentry
# ============================================================================
VITE_SENTRY_DSN=https://d4120668c0cafd04be9de8c62183794c@o4510361278611456.ingest.us.sentry.io/4510361279856640
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ============================================================================
# FEATURE FLAGS - Enable monitoring in production
# ============================================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# BUILD SETTINGS
# ============================================================================
NODE_ENV=production
VITE_APP_NAME=Echo Recipe Pro
VITE_APP_VERSION=1.0.0

# ============================================================================
# EXTERNAL APIS - If needed in production
# ============================================================================
VITE_USDA_API_KEY=your-production-usda-api-key

# ============================================================================
# SECURITY
# ============================================================================
VITE_CORS_ORIGINS=https://your-production-domain.com
VITE_API_TIMEOUT=30000
