# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# ============================================================================
# SUPABASE - Database & Authentication
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================================
# EXTERNAL APIS
# ============================================================================
# USDA FoodData Central API
VITE_USDA_API_KEY=your-usda-api-key

# ============================================================================
# ERROR MONITORING (Sentry)
# ============================================================================
VITE_SENTRY_DSN=https://your-key@o-id.ingest.sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.5

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# SUPPLIER INTEGRATIONS
# ============================================================================
# Sysco API (Optional)
VITE_SYSCO_API_KEY=
VITE_SYSCO_CLIENT_ID=

# US Foods API (Optional)
VITE_US_FOODS_API_KEY=
VITE_US_FOODS_CLIENT_ID=

# GFS API (Optional)
VITE_GFS_API_KEY=
VITE_GFS_CLIENT_ID=

# ============================================================================
# POS INTEGRATIONS
# ============================================================================
# Toast POS (Optional)
VITE_TOAST_API_KEY=
VITE_TOAST_CLIENT_ID=

# ============================================================================
# ANALYTICS
# ============================================================================
# Google Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=

# Mixpanel (Optional)
VITE_MIXPANEL_TOKEN=

# ============================================================================
# BUILD SETTINGS
# ============================================================================
NODE_ENV=production
VITE_APP_NAME=Echo Recipe Pro
VITE_APP_VERSION=1.0.0

# ============================================================================
# SERVER-SIDE (Backend/Netlify Functions)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (if using custom email service)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# ============================================================================
# SECURITY
# ============================================================================
# CORS Configuration
VITE_CORS_ORIGINS=https://your-domain.com
VITE_API_TIMEOUT=30000

# ============================================================================
# OPTIONAL MONITORING TOOLS
# ============================================================================
# Better Stack (Uptime Monitoring)
VITE_BETTER_STACK_API_KEY=

# LogRocket (Session Replay)
VITE_LOGROCKET_APP_ID=

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file to version control
# 2. Use the deployment platform's environment variable UI:
#    - Netlify: Site Settings > Build & Deploy > Environment
#    - Vercel: Project Settings > Environment Variables
# 3. Keep different values for staging vs production
# 4. Rotate sensitive keys periodically
# 5. Use least privilege principle for API keys
