# Development Environment Configuration
# Copy this file to .env.local and fill in your development values

# ============================================================================
# SUPABASE - Database & Authentication (REQUIRED FOR AUTH)
# ============================================================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================================
# EXTERNAL APIS (Optional)
# ============================================================================
# USDA FoodData Central API - Get from https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=your-usda-api-key

# OpenAI API Key - Required for recipe embeddings and AI features
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
ECHO_OPENAI_API_KEY=your-openai-api-key

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# Choose ONE of the following (or let system auto-detect):
# ============================================================================

# Option 1: pgvector (Supabase) - RECOMMENDED FOR SMALL VENUES (FREE)
# No additional configuration needed - uses existing Supabase setup
# Best for: < 5000 recipes, small/medium venues
# Cost: $0/month (included with Supabase)

# Option 2: Pinecone - RECOMMENDED FOR LARGE VENUES (PAID)
# For large-scale operations needing high performance
# Get API key from https://www.pinecone.io
# Cost: $30-$1000+/month depending on scale
PINECONE_API_KEY=your-pinecone-api-key

# Vector Engine Selection
# Options: "pinecone", "pgvector", "auto" (default)
# "auto" = use Pinecone if API key present, else pgvector
VECTOR_ENGINE=auto

# ============================================================================
# ERROR MONITORING - Sentry (Optional)
# ============================================================================
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.5

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# ============================================================================
# SUPPLIER INTEGRATIONS (Optional)
# ============================================================================
VITE_SYSCO_API_KEY=
VITE_SYSCO_CLIENT_ID=
VITE_US_FOODS_API_KEY=
VITE_US_FOODS_CLIENT_ID=
VITE_GFS_API_KEY=
VITE_GFS_CLIENT_ID=

# ============================================================================
# POS INTEGRATIONS (Optional)
# ============================================================================
VITE_TOAST_API_KEY=
VITE_TOAST_CLIENT_ID=

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# ============================================================================
# BUILD SETTINGS
# ============================================================================
NODE_ENV=development
VITE_APP_NAME=Echo Recipe Pro
VITE_APP_VERSION=1.0.0-dev

# ============================================================================
# SERVER-SIDE (Local Backend/Functions)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# SECURITY
# ============================================================================
VITE_CORS_ORIGINS=http://localhost:8080
VITE_API_TIMEOUT=30000
